      "id": "7ffcfd6a-db64-4114-abeb-e448936a9f12",
      "name": "Get thread details",
      "type": "n8n-nodes-base.gmail",
      "position": [
        32,
        720
      ],
      "typeVersion": 2,
      "webhookId": "8666f3c0-f0b5-4ddd-a1cc-3f67082a9eaf"
