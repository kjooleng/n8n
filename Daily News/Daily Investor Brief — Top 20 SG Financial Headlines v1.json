    {
      "parameters": {
        "jsCode": "const articles = $input.first().json.articles;\n\nconst lignes = articles.map((a, i) => {\n  const titre = (a.title || '')\n    .replace(/[^\\x20-\\x7E]/g, '')\n    .replace(/[\"\\\\]/g, '')\n    .replace(/:/g, '-')\n    //.substring(0, 70)\n    .trim();\n  const lien = (a.link || '').trim();\n  const content = (a.output || '').trim();\n  return (i + 1) + '. ' + titre + ' >>> ' + lien  + ' >>> ' + content;\n});\n\nconst texte = lignes.join(' ||| ');\n\nreturn [{ json: { texte, count: articles.length } }];"
      },
