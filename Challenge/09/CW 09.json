    {
      "parameters": {
        "url": "={{ (function c09StarterDataUrl(settings) {\n  const username = typeof settings?.username === 'string' ? settings.username.trim().toLowerCase() : '';\n  const key = typeof settings?.participantKey === 'string' ? settings.participantKey.trim().toUpperCase() : '';\n  if (!/^[a-z0-9_.-]{2,40}$/.test(username)\n    || ['your_username', 'your_community_username', 'community_username'].includes(username)) {\n    return 'Open Your account and enter your community username without @ before running';\n  }\n  if (!key || key.length > 128 || ['YOUR_PARTICIPANT_KEY', 'YOUR_KEY', 'REPLACE_ME'].includes(key)) {\n    return 'Open Your account and enter your current participant key before running';\n  }\n  return 'https://marketing.app.n8n.cloud/webhook/cwc/challenge-09/data';\n})($json) }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $json.username.trim().toLowerCase() }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-participant-key",
              "value": "={{ $json.participantKey.trim().toUpperCase() }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
